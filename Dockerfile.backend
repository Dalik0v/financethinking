FROM mcr.microsoft.com/dotnet/sdk:8.0

WORKDIR /src

# Copy only csproj first for restore
COPY AIProject/*.csproj ./AIProject/
RUN dotnet restore "AIProject/AIProject.csproj"

# Copy everything else
COPY . .

# Listen on 5193
EXPOSE 5193

# ASP.NET Core dev server, bind to 0.0.0.0
CMD ["dotnet", "run", "--project", "AIProject/AIProject.csproj", "--urls", "http://0.0.0.0:5193"]

